# syntax=docker/dockerfile:1
#
# Default variant: the slim image plus Chromium's headless shell, so the
# headless-Chrome runtime API (`/.runtime/{lua,lua_script,objects,logs}`) works.
#
# Also published with legacy `-runtime-api` compatibility tags.
ARG BASE_IMAGE=silverbullet:test
FROM ${BASE_IMAGE}

RUN apk add --no-cache chromium-headless-shell

# The Rust server's Chrome discovery reads CHROMIUM_PATH (see ChromeConfig).
ENV CHROMIUM_PATH=/usr/bin/chromium-headless-shell
