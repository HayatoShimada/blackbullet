# Copy to .env and `chmod 600 .env` (./setup.sh does both). Never commit .env.

# ---- app ----
# Folder holding your notes (plain Markdown files). Default: ./space next to this file.
SPACE_DIR=./space
# Local ports, bound to 127.0.0.1 only
BB_PORT=3000
MEMO_PORT=3010
# The containers run as this user so you can edit the files directly (setup.sh fills in yours)
PUID=1000
PGID=1000

# ---- search / MCP sidecar (packages/memo-mcp) ----
# Bearer token shared by the app (CONFIG page) and your AI clients. setup.sh generates one.
MEMO_MCP_TOKEN=
# Name of your notes as seen by search and MCP clients (`space=` argument). Keep it once chosen:
# the embedding cache is stored per name.
MEMO_SPACE_NAME=notes
# Embedding cache + model files: derived data, safe to delete
MEMO_INDEX_DIR=./.memo-index
# off = lexical search only, no model download (the model is ~120 MB, runs on the CPU)
MEMO_EMBED=on
# MEMO_EMBED_MODEL=Xenova/multilingual-e5-small
# If AI clients reach the sidecar through a reverse proxy or `tailscale serve`, the name they use:
# (With the tailnet front door below this defaults to SITE_DOMAIN; set it only for your own proxy.)
# MEMO_MCP_PUBLIC_HOST=memo.example.net:443

# ---- optional: tailnet-only HTTPS front door ----
# ./setup.sh --tailnet   (full setup, ACL and DNS steps: deploy/tailnet-proxy/README.md)
# Tailscale admin -> Settings -> Keys -> Generate auth key: tagged tag:blackbullet, pre-approved;
# single-use is fine (only the first join needs it).
TS_AUTHKEY=
TS_HOSTNAME=blackbullet
# Cloudflare -> My Profile -> API Tokens. Permissions: Zone/Zone/Read AND Zone/DNS/Edit, your zone only.
CF_API_TOKEN=
# Contact address for Let's Encrypt
ACME_EMAIL=
# Tailscale logins that may open the site, comma separated. Empty = nobody.
ALLOWED_LOGINS=
# The public name (an A record to the node's tailnet address, "DNS only")
SITE_DOMAIN=
# While trying things out (certificate not trusted, curl needs -k):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
