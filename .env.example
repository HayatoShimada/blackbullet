# Copy to .env and run `chmod 600 .env`. Never commit .env (it is in .gitignore).

# Tailscale admin -> Settings -> Keys -> Generate auth key.
# Give it the tag tag:blackbullet, pre-approved; single-use is fine (only the first join needs it).
TS_AUTHKEY=

# Cloudflare -> My Profile -> API Tokens. Permissions: Zone/Zone/Read AND Zone/DNS/Edit,
# for your zone only. Do not reuse a token that has other permissions.
CF_API_TOKEN=

# Contact address for Let's Encrypt
ACME_EMAIL=you@example.com

# Tailscale logins that may open the site, comma separated. Empty = nobody.
ALLOWED_LOGINS=alice@example.com,bob@example.com

# The public name (an A record to the node's tailnet address, "DNS only")
SITE_DOMAIN=app.example.com

# The app to protect: <container-or-alias>:<port>, reachable on APP_NETWORK
UPSTREAM=app:8080
# The name of the existing Docker network the app is on (must already exist)
APP_NETWORK=app_default

# Optional: the node's name in your tailnet
# TS_HOSTNAME=blackbullet

# While trying things out, enable this (the certificate is not trusted, so curl needs -k):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
